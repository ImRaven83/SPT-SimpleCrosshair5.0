<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SimpleCrosshair</AssemblyName>
    <Description>A simple pointfire crosshair</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    SPT 5.0 runs EFT on IL2CPP with BepInEx 6 (BepInEx.Unity.IL2CPP).
    Game assemblies are the Il2CppInterop-generated ones from BepInEx\interop.
    Each folder can be overridden individually, e.g. -p:TarkovInteropDir=...
  -->
  <PropertyGroup>
    <TarkovDir Condition=" '$(TarkovDir)' == '' ">..\..\</TarkovDir>
    <TarkovBepInExCoreDir Condition=" '$(TarkovBepInExCoreDir)' == '' ">$(TarkovDir)BepInEx\core\</TarkovBepInExCoreDir>
    <TarkovInteropDir Condition=" '$(TarkovInteropDir)' == '' ">$(TarkovDir)BepInEx\interop\</TarkovInteropDir>
    <TarkovBepInExSptDir Condition=" '$(TarkovBepInExSptDir)' == '' ">$(TarkovDir)BepInEx\plugins\sptushonka\</TarkovBepInExSptDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(TarkovInteropDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(TarkovInteropDir)Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(TarkovInteropDir)Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(TarkovInteropDir)Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(TarkovInteropDir)Il2CppSystem.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(TarkovInteropDir)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(TarkovInteropDir)UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(TarkovInteropDir)UnityEngine.UIModule.dll</HintPath>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(TarkovBepInExCoreDir)0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(TarkovBepInExCoreDir)BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(TarkovBepInExCoreDir)BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(TarkovBepInExCoreDir)BepInEx.Unity.Common.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(TarkovBepInExCoreDir)Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(TarkovBepInExCoreDir)Il2CppInterop.Common.dll</HintPath>
    </Reference>

    <Reference Include="SPTushonka.Reflection">
      <HintPath>$(TarkovBepInExSptDir)SPTushonka.Reflection.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Gets the commit hash from git -->
  <Target Name="SetSourceRevisionId" BeforeTargets="InitializeSourceControlInformation">
    <Exec
      Command="git describe --long --always --dirty --exclude=* --abbrev=8"
      ConsoleToMSBuild="True"
      IgnoreExitCode="False"
      >
      <Output PropertyName="SourceRevisionId" TaskParameter="ConsoleOutput"/>
    </Exec>
  </Target>

  <!-- Gets the version property from the VERSION.txt file -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <ItemGroup>
      <VersionFile Include="VERSION.txt" />
      <VersionCs Include="$(ProjectDir)Version.cs" />
      <Compile Include="@(VersionCs)" Exclude="@(VersionCs)" /> <!-- Resolves double include -->
      <FileWrites Include="@(VersionCs)" />
    </ItemGroup>

    <ReadLinesFromFile File="@(VersionFile)">
      <Output TaskParameter="Lines" PropertyName="Version" />
    </ReadLinesFromFile>

    <!-- Write the version to Version.cs, kind of a hack to get version info into BepInEx -->
    <WriteLinesToFile File="@(VersionCs)" Overwrite="true" Lines="// HACK: autogenerated file containing version info from VERSION.txt"/>
    <WriteLinesToFile File="@(VersionCs)" Lines="namespace SimpleCrosshair{public static class BuildInfo {public const string Version = &quot;$(Version)&quot;%3B}}"/>
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <OutputDLL Include="$(ProjectDir)$(OutDir)$(TargetName).dll" />
      <License Include="$(ProjectDir)LICENSE.txt" />
      <Resources Include="$(ProjectDir)Resources\*" />
    </ItemGroup>

    <!-- Copies the output and resources to tarkov game folder, if it exists -->
    <Copy
      Condition="Exists('$(TarkovDir)BepInEx\plugins')"
      SourceFiles="@(OutputDLL);@(Resources);@(License)"
      DestinationFolder="$(TarkovDir)BepInEx\plugins\SimpleCrosshair"
    />

    <!-- Creates a release zip file -->
    <RemoveDir Directories="$(ProjectDir)release" />
    <Copy
      SourceFiles="@(OutputDLL);@(Resources);@(License)"
      DestinationFolder="$(ProjectDir)release\SimpleCrosshair\BepInEx\plugins\SimpleCrosshair"
    />
    <ZipDirectory
      SourceDirectory="$(ProjectDir)release\SimpleCrosshair\"
      DestinationFile="$(ProjectDir)release\SimpleCrosshair-$(Version)-$(SourceRevisionId).zip"
    />
  </Target>

</Project>
